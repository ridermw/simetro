  "catalog": {
    "slug": "greenhouse-water-watch",
    "title": "Greenhouse Water Watch",
    "version": "0.1.0",
    "author": "simetro",
    "description": "An automated greenhouse where weather sensors, water pumps, soil monitors, and irrigation grids must keep every grow bed watered through drought spells and pump failures.",
    "tags": [
      "sl1",
      "scenario_language_v1",
      "greenhouse",
      "water",
      "agriculture",
      "intro",
      "draft"
    ],
    "palette_note": "Natural green and earth palette: dark background, amber pipeline, teal soil monitors, coral drought alerts, green healthy plants, violet control desk.",
    "layout_note": "Six SL1 places form a sensor-to-plant pipeline: outdoor weather sensor left, pump room, soil monitor center, irrigation grid, plant nursery right, control desk above. Layout reads as a water journey from sky to root.",
    "node_language_note": "Place roles: source=weather-sensor, processor=water-pump/irrigation-grid, buffer=soil-monitor, dashboard=plant-nursery, operator=control-desk. Shapes reinforce role: triangle=source, hexagon=processor, diamond=buffer, square=dashboard, circle=operator.",
    "mover_path_note": "No legacy movers; SL1 links carry control and data flow. Six links span sensor-to-nursery plus two control buses from the desk.",
    "review_note": "Draft pending SL1 renderer. Schema validates against the PR-7 loader."
  },
