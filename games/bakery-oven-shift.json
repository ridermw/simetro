      "sl1",
      "scenario_language_v1",
      "bakery",
      "oven",
      "food",
      "easy",
      "draft"
    ],
    "palette_note": "Warm bakery palette: dark background, cream foreground, amber flour/dough, orange bake, golden product, warm brown sales. Evokes a working commercial kitchen.",
    "layout_note": "Six SL1 places form an ingredient-to-counter pipeline: ingredient store far left, prep station, proofing rack above, main oven center-right, sales counter far right, shift supervisor above.",
    "node_language_note": "Place roles: source=ingredient-store, processor=prep-station/main-oven, buffer=proofing-rack, dashboard=sales-counter, operator=shift-supervisor.",
    "mover_path_note": "No legacy movers; SL1 links carry food flows. Six links span store-to-counter plus two bidirectional supervisor control buses.",
    "review_note": "Draft pending SL1 renderer. Validates against PR-7 strict loader."
  },
