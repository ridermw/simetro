  "catalog": {
    "slug": "sensor-calibration-lab",
    "title": "Sensor Calibration Lab",
    "version": "0.1.0",
    "author": "simetro",
    "description": "A metrological calibration laboratory where raw sensor outputs must be corrected against certified reference standards before temperature drift and equipment wear degrade measurement traceability.",
    "tags": [
      "sl1",
      "scenario_language_v1",
      "calibration",
      "sensor",
      "lab",
      "intro",
      "draft"
    ],
    "palette_note": "Precision metrology palette: dark background, steel foreground, blue raw inputs, amber offsets, green reference, teal validated, violet operator. Clinical and legible.",
    "layout_note": "Six SL1 places form a measurement-to-certification pipeline: test bench left, calibration rack, reference standard above, validation suite right, log terminal far right, tech station above center.",
    "node_language_note": "Place roles: source=test-bench, processor=calibration-rack/validation-suite, buffer=reference-standard, dashboard=log-terminal, operator=tech-station. Shapes: square=bench/terminal, hexagon=processor, diamond=reference, circle=operator.",
    "mover_path_note": "No legacy movers; SL1 links carry sample and result flows. Six links span bench-to-log plus two bidirectional tech control buses.",
    "review_note": "Draft pending SL1 renderer. Validates against PR-7 strict loader."
  },
