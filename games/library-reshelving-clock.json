  "catalog": {
    "slug": "library-reshelving-clock",
    "title": "Library Reshelving Clock",
    "version": "0.1.0",
    "author": "simetro",
    "description": "A public library where a returning tide of books must be sorted, catalogued, shelved, and surfaced as availability reports before the reading-room backlog grows unmanageable.",
    "tags": [
      "sl1",
      "scenario_language_v1",
      "library",
      "catalog",
      "operations",
      "intro",
      "draft"
    ],
    "palette_note": "Warm library palette: dark background, sand foreground, blue intake, amber sort, green catalog, teal shelf, violet operator. Low-saturation tones evoke paper and wood.",
    "layout_note": "Six SL1 places form a returns-to-reading pipeline: return desk at far left, sort station, catalog database above, shelf zone right, reading room far right, librarian post above center.",
    "node_language_note": "Place roles: source=return-desk, processor=sort-station/shelf-zone, buffer=catalog-db, dashboard=reading-room, operator=librarian-post. Shapes vary: circle=source/reading-room, square=sort, diamond=catalog, hexagon=shelf/librarian.",
    "mover_path_note": "No legacy movers; SL1 links carry item flows. Six links span returns-to-reading plus two bidirectional oversight buses from the librarian.",
    "review_note": "Draft pending SL1 canvas renderer. Validates against PR-7 strict loader."
  },
  "pieces": {
    "nodes": [],
    "paths": [],
    "movers": []
  },
  "goals": [
    {
      "type": "loop_forever"
    }
  ],
  "agents": [],
