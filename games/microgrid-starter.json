    "slug": "microgrid-starter",
    "title": "Microgrid Starter",
    "version": "0.1.0",
    "author": "simetro",
    "description": "A rooftop solar microgrid where battery banks, inverters, and local distribution must serve peak loads through cloud cover and inverter thermal limits.",
    "tags": [
      "sl1",
      "scenario_language_v1",
      "microgrid",
      "solar",
      "energy",
      "intro",
      "draft"
    ],
    "palette_note": "Electric energy palette: dark background, warm foreground, amber solar, cyan battery, green inverter, teal distribution, violet operator. Distinct from transit scenes.",
    "layout_note": "Six SL1 places form a generation-to-metering chain: solar array top-left, battery bank, inverter hub center, local grid, meter panel right, grid operator above center.",
    "node_language_note": "Place roles: source=solar-array, buffer=battery-bank, processor=inverter-hub/local-grid, dashboard=meter-panel, operator=grid-operator. Shapes: triangle=source, square=buffer/dashboard, hexagon=inverter, diamond=grid.",
    "mover_path_note": "No legacy movers; SL1 links carry power and telemetry. Six links span solar-to-meter plus two bidirectional control buses.",
    "review_note": "Draft pending SL1 renderer. Validates against PR-7 strict loader."
  },
