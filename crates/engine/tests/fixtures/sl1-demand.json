{
  "schema_version": 1,
  "name": "sl1-demand",
  "theme": {
    "palette": ["#0a1c2e", "#1aa6e0", "#f0c419"],
    "background_index": 0,
    "font": "system-ui"
  },
  "pieces": {
    "nodes": [],
    "paths": [],
    "movers": []
  },
  "scenario_language_v1": {
    "places": [
      {
        "id": "dashboard",
        "role": "consumer",
        "pos": [0.0, 0.0],
        "capacity": { "queries": 8 },
        "storage": {
          "report": { "capacity": 100, "initial": 10 }
        },
        "accepts": ["report"],
        "produces": []
      },
      {
        "id": "factory",
        "role": "producer",
        "pos": [10.0, 0.0],
        "capacity": { "machine_hours": 4 },
        "storage": {
          "raw_material": { "capacity": 100, "initial": 100 },
          "report": { "capacity": 50, "initial": 0 }
        },
        "accepts": ["raw_material"],
        "produces": ["report"]
      }
    ],
    "things": [
      { "id": "raw_material", "kind": "input", "tags": [] },
      {
        "id": "report",
        "kind": "data",
        "tags": ["observation"],
        "freshness_budget_ticks": 100
      }
    ],
    "transforms": [
      {
        "id": "refresh_report",
        "type": "data_refresh",
        "runs_on": "factory",
        "inputs": [{ "thing": "raw_material", "amount": 1 }],
        "outputs": [{ "thing": "report", "amount": 1 }],
        "cadence_ticks": 5,
        "duration_ticks": 2,
        "deadline_ticks": 10,
        "capacity_cost": { "machine_hours": 2 },
        "failure_policy": "retry_then_warn",
        "max_attempts": 2
      }
    ],
    "demand": [
      {
        "id": "fixed_dashboard_refresh",
        "type": "report_refresh",
        "target": { "type": "place", "id": "dashboard" },
        "requires": ["report"],
        "spawn_schedule": {
          "type": "fixed",
          "every_ticks": 10,
          "start_tick": 5
        },
        "deadline_ticks": 12,
        "priority": "normal",
        "value": 10,
        "penalty": { "score": -3, "warning": "report stale" }
      },
      {
        "id": "scripted_priority_query",
        "type": "executive_query",
        "target": { "type": "place", "id": "dashboard" },
        "requires": ["report"],
        "spawn_schedule": {
          "type": "scripted",
          "ticks": [3, 17, 41]
        },
        "deadline_ticks": 5,
        "priority": "high",
        "value": 25,
        "penalty": { "score": -10 }
      }
    ]
  }
}
