    "places": [
      {
        "id": "kusto-cluster",
        "role": "compute",
        "pos": [120.0, 80.0],
        "capacity": {
          "query_slots": 64,
          "cooling_tons": 0
        },
        "storage": {
          "hot_cache": { "capacity": 1024, "initial": 256 }
        },
        "accepts": ["query", "ingestion"],
        "produces": ["result"],
        "failure_domains": ["eastus", "az1", "data-platform"],
        "operating_states": {
          "strained": { "when": "query_slots.used_percent >= 80" },
          "overloaded": { "when": "query_slots.used_percent >= 95", "grace_ticks": 120 },
          "failed": { "when": "overloaded_ticks > 600" }
        }
      },
      {
        "id": "gpu-fleet",
        "role": "compute",
        "pos": [320.0, 80.0],
        "capacity": {
