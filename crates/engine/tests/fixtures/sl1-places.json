        "produces": ["model_artifact"],
        "failure_domains": ["eastus", "az2"],
        "operating_states": {
          "saturated": { "when": "gpus.used_percent >= 90", "grace_ticks": 30 }
        }
      },
      {
        "id": "dashboard",
        "role": "observability",
