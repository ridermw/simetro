{
  "name": "simetro-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "simetro frontend — Vite + TypeScript + Canvas2D + Tone.js. Per PLAN §3.1 / §4.",
  "scripts": {
    "dev": "vite",
    "build": "npm run emit-static && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "emit-static": "cd .. && cargo run -q -p simetro-headless -- emit-static --scenes-dir games --output-dir frontend/public/static-payloads"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
